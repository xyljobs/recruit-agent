# 智聘Agent独立部署环境变量
# 复制为 .env.local 后填入真实值，禁止提交任何真实密钥。

# ---------- 自托管 Supabase ----------
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 数据库迁移使用的 PostgreSQL 直连地址。
# 自托管 Supabase 时 localhost:5432 为 Supavisor 会话模式，用户名需带租户后缀
# （POOLER_TENANT_ID=zhipin 时为 postgres.zhipin），见 docs/Mac-mini-M4数据库安装步骤.md。
PGDATABASE_URL=postgresql://postgres:your-password@localhost:5432/postgres

# ---------- AI 执行边界（默认纯规则，失败时也回退为纯规则） ----------
# rules_only: 不调用任何模型/知识服务；private_endpoint: 企业私有兼容端点；
# approved_cloud: 经管理员批准的外部端点，仅发送去标识化载荷。
AI_EXECUTION_MODE=rules_only
APPROVED_CLOUD_PROCESSORS=
# ATS 出站 Worker 的精确 HTTPS 主机白名单，逗号分隔；为空时拒绝所有外发。
INTEGRATION_OUTBOUND_ALLOWED_HOSTS=
# private_endpoint 模式填写 PRIVATE_LLM_BASE_URL；非内网主机还需由管理员确认边界。
# PRIVATE_LLM_BASE_URL=http://model.internal/v1
# 原始简历 Worker 若使用非私网 DNS，必须把主机精确列入此部署白名单。
# PRIVATE_LLM_ALLOWED_HOSTS=model.customer.example
# AI_PRIVATE_ENDPOINT_CONFIRMED=false
# approved_cloud 模式填写 APPROVED_CLOUD_LLM_BASE_URL 和 APPROVED_CLOUD_PROCESSORS，
# 然后由每个企业的管理员在“数据源”页逐项批准；未批准时仍按 rules_only 运行。
# APPROVED_CLOUD_LLM_BASE_URL=https://approved-model.example/v1

# ---------- 可选模型（OpenAI 兼容模式） ----------
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# 候选人报告默认完全本地分析。启用外部AI时只发送去标识化能力画像，
# 不发送姓名、联系方式、公司名、截图或原始简历文本。
CANDIDATE_REPORT_MODE=local
ALLOW_EXTERNAL_RESUME_ANALYSIS=false

# 简历批处理会将原始简历文本发送给上方配置的模型生成推荐理由。
# 充分确认候选人授权与公司数据政策后，必须显式改为 true 才允许 Worker 执行。
ALLOW_EXTERNAL_RESUME_BATCH_ANALYSIS=false
# 扫描版 PDF 使用的视觉模型；应选择支持图片输入的模型。
RESUME_VL_MODEL=qwen-vl-max
PIPELINE_WORKERS=8

# ---------- 安全密钥（必须） ----------
# ENCRYPTION_KEY / HMAC_KEY 必须是 64 位 hex；各密钥必须独立。
ENCRYPTION_KEY=
HMAC_KEY=
# 应用登录 JWT 使用的独立密钥。
JWT_SECRET=
# 必须与 Supabase 运行环境的 JWT_SECRET 一致，仅服务端使用，用于签发短期 RLS 令牌。
SUPABASE_JWT_SECRET=

# ---------- 一次性管理员初始化（不要持久化到 .env.local） ----------
# 仅在执行 pnpm admin:bootstrap 时由部署平台临时注入，成功后立即删除这些 Secret。
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ORGANIZATION_NAME=
# BOOTSTRAP_ORGANIZATION_SLUG=

# ---------- 运行 ----------
# 公网或内网 HTTPS 部署时填写完整地址，例如 https://zhipin.example.com
APP_URL=http://localhost:5000
PORT=5000

# 可选：批量匹配 Worker 实例标识；不设置时自动生成。
# MATCH_BATCH_WORKER_ID=match-worker-01
# INTEGRATION_OUTBOX_WORKER_ID=integration-worker-01

# Boss Worker 生成的简历根目录。生产环境使用 Next.js standalone 时建议填写绝对路径。
# BOSS_RESUME_DIR=/absolute/path/to/zhipin-agent/assets/简历
