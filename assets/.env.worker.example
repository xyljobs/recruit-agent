# Boss Worker 本地配置
# 复制此文件为 .env.worker 并填入真实值
# ⚠️ .env.worker 已被 .gitignore 排除，不会被提交到 git

# Supabase 配置
# URL: 与 Web 应用使用同一个自托管 Supabase 项目
# KEY: 使用 service role key（eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... 开头）
#      Worker 需要写权限来更新任务状态、写入搜索结果
#      ⚠️ service role key 绕过 RLS，仅限本地 Worker 使用，不要暴露到前端
#
# 获取方式：
#   1. 登录 Supabase Dashboard
#   2. Settings → API
#   3. 复制 Project URL 和 service_role key
#
# Mac mini 本机运行 Worker 时通常使用 http://localhost:8000
WORKER_SUPABASE_URL=http://localhost:8000
WORKER_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# 简历批处理 Worker 解密钉钉 MCP 凭证时使用。
# 必须与项目根目录 .env.local 中的 ENCRYPTION_KEY 完全一致。
ENCRYPTION_KEY=

# 简历推荐理由复用项目根目录 .env.local 的 LLM_* 配置。
# 仅当 Worker 不在项目目录中运行时，才需要在此重复配置。
# LLM_API_KEY=
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# AI_EXECUTION_MODE=rules_only
# PRIVATE_LLM_ALLOWED_HOSTS=model.customer.example
# RESUME_VL_MODEL=qwen-vl-max
# PIPELINE_WORKERS=8
# ALLOW_EXTERNAL_RESUME_BATCH_ANALYSIS=false

# 可选：自定义 Worker ID（默认自动生成）
# WORKER_ID=my-worker-01

# 外部AI评估（可选）
# 默认 local：原始简历始终留在本机。
# external_ai 只发送本地提取的去标识化能力画像，且需要显式授权。
CANDIDATE_REPORT_MODE=local
ALLOW_EXTERNAL_RESUME_ANALYSIS=false
